# ExamGuard environment template — safe placeholders only, never commit real values.
# Copy to .env for local development.

# --- Core Environment ---
NODE_ENV=development
APP_ENV=development
API_PORT=4000

# --- Database ---
DATABASE_URL=postgresql://examguard:examguard@localhost:5432/examguard?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Authentication & Secrets ---
# Production requirement: Must be at least 16 characters and not use dev default strings.
# Generate strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- CORS & Origins ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Media Server / SFU ---
SFU_PORT=4010
SFU_HOST=127.0.0.1
WEBRTC_SERVER_URL=ws://localhost:4010/sfu
SFU_RTC_MIN_PORT=40000
SFU_RTC_MAX_PORT=49999
SFU_ANNOUNCED_IP=
# Internal key the API presents when evicting SFU rooms for ended attempts.
SFU_ADMIN_KEY=change-me-sfu-admin-key
MEDIA_SWEEP_INTERVAL_MS=20000
MEDIA_SWEEP_LEASE_MS=90000

# --- Recording & Object Storage ---
# STORAGE_DRIVER: 'local' (default) or 's3'
STORAGE_DRIVER=local
RECORDING_STORAGE_DIR=storage/recordings
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=examguard-recordings
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- AI & Vision Proctoring ---
AI_SERVICE_URL=

# --- Notifications ---
SMTP_URL=

# --- Rate Limiting & Throttling ---
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=60