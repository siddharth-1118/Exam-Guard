# ExamGuard environment template — never commit real values.
# Copy to .env and fill in locally.

# --- Database ---
DATABASE_URL=postgresql://examguard:examguard@localhost:5432/examguard?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# --- API ---
API_PORT=4000
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# --- Object storage (Phase 4) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=examguard

# --- Media server / SFU (Phase 4) ---
WEBRTC_SERVER_URL=
# Internal key the API presents when evicting SFU rooms for ended attempts.
SFU_ADMIN_KEY=change-me-sfu-admin-key
# Media-participant stale-session sweeper (defaults: 20000ms interval, 90000ms lease).
MEDIA_SWEEP_INTERVAL_MS=
MEDIA_SWEEP_LEASE_MS=

# --- AI service (Phase 5) ---
AI_SERVICE_URL=

# --- Notifications (Phase 7) ---
SMTP_URL=