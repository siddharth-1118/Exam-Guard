{
  "name": "@examguard/student-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "ExamGuard secure student desktop examination application (Windows/macOS/Linux)",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "pnpm build:main && pnpm build:renderer",
    "build:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist/main/main.js && esbuild electron/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=dist/main/preload.js",
    "build:renderer": "vite build",
    "dev": "pnpm build && electron .",
    "dev:renderer": "vite",
    "start": "electron .",
    "smoke": "pnpm build && electron . --smoke-test",
    "test": "jest",
    "package:win": "pnpm build && electron-builder --win nsis",
    "package:mac": "pnpm build && electron-builder --mac dmg",
    "package:linux": "pnpm build && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "org.examguard.student-desktop",
    "productName": "ExamGuard",
    "directories": {
      "output": "dist/installer"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "dependencies": {
    "@examguard/types": "workspace:*",
    "mediasoup-client": "^3.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "vite": "^8.0.0"
  }
}